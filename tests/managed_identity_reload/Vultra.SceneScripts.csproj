    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);VULTRA_IDENTITY_RELOAD</DefineConstants>
    <DefineConstants Condition="'$(VultraGroupNarrow)' == 'true'">$(DefineConstants);VULTRA_GROUP_NARROW</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../scene_scripts/IdentityProbe.cs" Link="IdentityProbe.cs" />
    <Compile Include="../scene_scripts/ExportProbe.cs" Link="ExportProbe.cs" />
    <Compile Include="../scene_scripts/ValueProbe.cs" Link="ValueProbe.cs" />
    <Compile Include="../scene_scripts/ClassReferences.cs" Link="ClassReferences.cs" />
  </ItemGroup>
  <Import Project="../../source/scripting/managed/Vultra.Scripting.props" />
</Project>
